{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "test",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "cb3d4ff9-cc78-48a4-ad0e-c56710632893","database_name": "test1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d0d824164e0340f6989ae398e07d572e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
